{
    "type": "object",
    "properties": {
        "name": {
            "type": "string"
        },
        "description": {
            "type": "string"
        },
        "version": {
            "type": "string"
        },
        "homepage": {
            "type": "string",
            "format": "uri"
        },
        "covers": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "screenshots": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "saves": {
            "type": "object",
            "description": "Glob based location of save files per platform and architecture.",
            "patternProperties": {
                ".*": {
                    "type": "object",
                    "patternProperties": {
                        ".*": {
                            "type": "object",
                            "properties": {
                                "cwd": {
                                    "description": "Root Directory of the sames. Supports environmental variables using mustache templating. Saves will keep sub directory layout based on this root.",
                                    "type": "string"
                                },
                                "globs": {
                                    "description": "Glob pattern for the save files",
                                    "type": "array",
                                    "items": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "downloads": {
            "description": "All download locations for the game.",
            "type": "object",
            "patternProperties": {
                ".*": {
                    "oneOf": [
                        {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "const": "direct"
                                },
                                "url": {
                                    "description": "The download URL",
                                    "type": "string",
                                    "format": "uri"
                                },
                                "system": {
                                    "description": "Platform and architecture the game download is for. Works with bun compatible platform and architecture with `:` as separator",
                                    "examples": [
                                        "win32:x64",
                                        "linux:arm64"
                                    ],
                                    "type": "string"
                                },
                                "name": {
                                    "description": "Name for the download options as it will appear in the UI",
                                    "type": "string"
                                },
                                "main": {
                                    "description": "Glob ofr the main executable file.",
                                    "type": "string"
                                },
                                "saves": {
                                    "type": "object",
                                    "patternProperties": {
                                        ".*": {
                                            "type": "object",
                                            "properties": {
                                                "cwd": {
                                                    "type": "string"
                                                },
                                                "globs": {
                                                    "type": "array",
                                                    "items": {
                                                        "type": "string"
                                                    }
                                                }
                                            },
                                            "required": [
                                                "cwd",
                                                "globs"
                                            ]
                                        }
                                    }
                                }
                            },
                            "required": [
                                "type",
                                "url",
                                "system"
                            ]
                        },
                        {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "const": "itch"
                                },
                                "path": {
                                    "type": "string"
                                },
                                "name": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "type",
                                "path"
                            ]
                        },
                        {
                            "type": "object",
                            "properties": {
                                "type": {
                                    "const": "moddb"
                                },
                                "file_id": {
                                    "description": "Stable numeric ModDB file ID resolved to a fresh mirror at install time.",
                                    "type": "number"
                                },
                                "file_name": {
                                    "description": "The upstream archive filename used for local storage and extraction.",
                                    "type": "string"
                                },
                                "system": {
                                    "description": "Platform and architecture the game download is for.",
                                    "type": "string"
                                },
                                "name": {
                                    "description": "Name for the download option as it will appear in the UI.",
                                    "type": "string"
                                },
                                "main": {
                                    "description": "Glob for the main executable or supported wrapper.",
                                    "type": "string"
                                },
                                "additional_files": {
                                    "description": "Extra non-archive runtime files downloaded into the game installation directory.",
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "url": {
                                                "type": "string",
                                                "format": "uri"
                                            },
                                            "file_name": {
                                                "type": "string"
                                            }
                                        },
                                        "required": [
                                            "url",
                                            "file_name"
                                        ]
                                    }
                                },
                                "launch": {
                                    "description": "Specification for a generated platform launch wrapper.",
                                    "type": "object",
                                    "properties": {
                                        "wrapper": {
                                            "type": "string"
                                        },
                                        "executable": {
                                            "type": "string"
                                        },
                                        "cwd": {
                                            "type": "string"
                                        },
                                        "args": {
                                            "type": "array",
                                            "items": {
                                                "type": "string"
                                            }
                                        },
                                        "bindings": {
                                            "description": "Controller bindings inserted into the game configuration when the button is not already bound.",
                                            "type": "object",
                                            "additionalProperties": {
                                                "type": "string"
                                            }
                                        }
                                    },
                                    "required": [
                                        "wrapper",
                                        "executable",
                                        "args"
                                    ]
                                }
                            },
                            "required": [
                                "type",
                                "file_id",
                                "file_name",
                                "system"
                            ]
                        }
                    ]
                }
            }
        },
        "companies": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "genres": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "system": {
            "description": "Global system and architecture of the game. Uses bun compatible platform and arch separated by `:`",
            "type": "string"
        },
        "igdb_id": {
            "description": "IGDB ID for the game. Will be used to fetch and update metadata",
            "type": "number"
        },
        "ra_id": {
            "description": "Retro Achievements ID",
            "type": "number"
        },
        "sgdb_id": {
            "type": "number"
        },
        "keywords": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "first_release_date": {
            "oneOf": [
                {
                    "type": "number"
                },
                {
                    "type": "string",
                    "format": "date"
                }
            ]
        },
        "player_count": {
            "type": "string"
        },
        "age_ratings": {
            "type": "array",
            "items": {
                "type": "string"
            }
        }
    },
    "required": [
        "name",
        "homepage",
        "covers",
        "version"
    ]
}
